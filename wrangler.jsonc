{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-mygpt-github",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "vars": {
    "ALLOWED_REPOS": "*",
    "PINNED_REPOS": "xiaoqianran/*",
    "MAX_MIRROR_FILE_BYTES": "524288",
    "MAX_INDEX_CHARS": "20000",
    "MAX_REPO_MIRROR_BYTES": "300000000",
    "MAX_TOTAL_MIRROR_BYTES": "8000000000",
    "MIRROR_TTL_DAYS": "7",
    "R2_GC_MAX_OBJECTS": "500",
    "MAX_EXPIRE_REPOS_PER_RUN": "20"
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "d1_databases": [
    {
      "binding": "REPO_DB",
      "migrations_dir": "migrations",
      "database_id": "8505e580-f006-4841-844f-9868d8a1bbbd"
    }
  ],
  "r2_buckets": [
    {
      "binding": "REPO_BLOBS",
      "bucket_name": "cloudflare-mygpt-github-repo-blobs"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "REPO_SYNC_QUEUE",
        "queue": "cloudflare-mygpt-github-sync"
      }
    ],
    "consumers": [
      {
        "queue": "cloudflare-mygpt-github-sync",
        "max_batch_size": 1,
        "max_batch_timeout": 1
      }
    ]
  }
}
